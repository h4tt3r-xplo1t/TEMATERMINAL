<?xml version="1.0" encoding="UTF-8"?>
<colorScheme name="Purple Cyberpunk" version="1">
  <author>h4tt3r-xplo1t</author>
  <description>Tema morado futurista estilo cyberpunk para Ptyxis - Inspirado en seguridad digital y programación futurista</description>
  
  <!-- Colores básicos del tema -->
  <color name="background" value="#0a0014"/>
  <color name="foreground" value="#e0b0ff"/>
  <color name="cursor" value="#ff00ff"/>
  <color name="selection" value="#4d0099"/>
  
  <!-- Paleta de 16 colores estándar (compatible con ANSI) -->
  <palette>
    <!-- Colores oscuros (0-7) -->
    <color index="0" value="#1a0033"/>  <!-- Negro - Fondo oscuro para texto -->
    <color index="1" value="#ff1493"/>  <!-- Rojo - Errores y alertas (Deep Pink) -->
    <color index="2" value="#00ff88"/>  <!-- Verde - Éxito y comandos exitosos -->
    <color index="3" value="#ffaa00"/>  <!-- Amarillo - Advertencias y atención -->
    <color index="4" value="#7700ff"/>  <!-- Azul - Información (Morado Oscuro) -->
    <color index="5" value="#ff00ff"/>  <!-- Magenta - Palabras clave -->
    <color index="6" value="#00ffff"/>  <!-- Cyan - Enlaces y acentos -->
    <color index="7" value="#e0b0ff"/>  <!-- Blanco - Texto principal (Lavanda) -->
    
    <!-- Colores brillantes (8-15) -->
    <color index="8" value="#4d0099"/>  <!-- Gris Oscuro - Texto secundario (Morado) -->
    <color index="9" value="#ff1493"/>  <!-- Rojo Brillante - Errores prominentes -->
    <color index="10" value="#00ff88"/> <!-- Verde Brillante - Éxito prominente -->
    <color index="11" value="#ffaa00"/> <!-- Amarillo Brillante - Advertencias prominentes -->
    <color index="12" value="#9933ff"/> <!-- Azul Brillante - Información prominente -->
    <color index="13" value="#ff00ff"/> <!-- Magenta Brillante - Énfasis -->
    <color index="14" value="#00ffff"/> <!-- Cyan Brillante - Acentos brillantes -->
    <color index="15" value="#ffffff"/> <!-- Blanco Puro - Máximo contraste -->
  </palette>
  
  <!-- Propiedades adicionales -->
  <property name="bold-color-same-as-fg">true</property>
  <property name="bold-is-bright">true</property>
  <property name="use-theme-colors">false</property>
</colorScheme>
